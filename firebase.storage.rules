rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read for authenticated users
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }

    // Allow uploads for task attachments and submissions for authenticated users
    match /task_attachments/{file} {
      allow write: if request.auth != null && isProfessor(request.auth.uid);
      allow read: if request.auth != null;
    }

    match /submissions/{file} {
      allow write: if request.auth != null; // students and professors can write (students submit)
      allow read: if request.auth != null;
    }

    function isProfessor(uid){
      return exists(/databases/(default)/documents/users/$(uid)) &&
        get(/databases/(default)/documents/users/$(uid)).data.role == 'professor';
    }
  }
}
